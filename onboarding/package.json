{
  "name": "inside-socket-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run content:check && npm run assets:check && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "content:check": "node scripts/source-atlas.mjs && node scripts/check-content.mjs",
    "content:update": "node scripts/source-atlas.mjs --update",
    "assets:build": "node scripts/build-assets.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "audio:build": "node scripts/build-audio.mjs",
    "benchmark": "playwright test tests/browser/performance.spec.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
