# Run from the repository root, or use tools/docs.py build.
PROJECT_NAME           = "Socket Chat"
OUTPUT_DIRECTORY       = build/docs/doxygen
INPUT                  = include src apps tests
FILE_PATTERNS          = *.hpp *.cpp
RECURSIVE              = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_PROGRAMLISTING     = NO
HAVE_DOT               = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = "TEST(suite,name)=void suite##_##name()" \
                         "TEST_F(suite,name)=void suite##_##name()"
